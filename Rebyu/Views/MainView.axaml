<UserControl
    x:Class="Rebyu.Views.MainView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
    xmlns:converters="using:Rebyu.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:fa="using:FluentAvalonia.UI.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
    xmlns:models="using:Rebyu.Models"
    xmlns:vm="using:Rebyu.ViewModels"
    MinWidth="600"
    MinHeight="400"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:MainViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToObjectConverter
            x:Key="UserOrAITextConverter"
            FalseValue="🤖 AI Agent"
            TrueValue="👤 User" />
        <converters:ChatAuthorToObjectConverter x:Key="ChatAuthorConverter" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="PathIcon">
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="ShowsPreview" Value="True" />
        </Style>

        <Style Selector="Border">
            <Setter Property="BorderBrush" Value="#3d444d" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#2C2C2C" />
        </Style>

        <Style Selector="ListBox.filters ListBoxItem:selected Border">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="TabControl WrapPanel">
            <Setter Property="MaxHeight" Value="20" />
            <Setter Property="Margin" Value="0,5,0,20" />
        </Style>

        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 0 0 0" />
            <Setter Property="Padding" Value="10 0" />
            <Setter Property="BorderThickness" Value="0 0 0 0" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="TabItem > TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Styles>

    <Grid Margin="4">
        <!--  App View  -->
        <Grid IsVisible="{Binding IsConnected}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Top Section with Header and Menus  -->
            <Grid
                Grid.Row="0"
                Margin="8,4"
                ColumnDefinitions="*,Auto,*">
                <!--  Database Path Display  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <PathIcon
                        Width="16"
                        Height="16"
                        VerticalAlignment="Center"
                        Data="{StaticResource folder_regular}"
                        Foreground="#4CAF50" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold">
                        <Run Text="{Binding SelectedDatabase.Directory}" />
                        <Run Text=" > " />
                        <Run Text="{Binding SelectedDatabase.Name}" />
                    </TextBlock>
                </StackPanel>

                <!--  Database Table Count  -->
                <TextBlock
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Text="{Binding SelectedDatabase.TableCount, StringFormat=Database Tables: {0}}" />

                <!--  Action Buttons  -->
                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Padding="8,4"
                        Background="#46C263"
                        BorderThickness="1"
                        Content="Save Session"
                        ToolTip.Tip="Save the current session" />
                    <Button
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#E33437"
                        ToolTip.Tip="Disconnect from the database">
                        <PathIcon
                            Width="16"
                            Height="16"
                            Data="{StaticResource plug_disconnected_regular}"
                            Foreground="#E33437" />
                    </Button>
                </StackPanel>
            </Grid>



            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" MinWidth="150" />
                    <ColumnDefinition Width="2" />
                    <ColumnDefinition Width="*" MinWidth="150" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.3*" MinHeight="150" />
                        <RowDefinition Height="2" />
                        <RowDefinition Height="*" MinHeight="150" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="150" />
                            <ColumnDefinition Width="2" />
                            <ColumnDefinition Width="2*" MinWidth="150" />
                        </Grid.ColumnDefinitions>

                        <!--  TREE VIEW  -->
                        <Border
                            Grid.Column="0"
                            Margin="2,0,0,0"
                            BorderThickness="1">
                            <Grid Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Margin="4,2"
                                    HorizontalAlignment="Stretch"
                                    ColumnDefinitions="Auto,*">
                                    <Button
                                        Grid.Column="0"
                                        Margin="4,0,8,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        Background="#4CAF50"
                                        BorderBrush="#388E3C"
                                        BorderThickness="1"
                                        Foreground="#FFFFFF"
                                        ToolTip.Tip="Refresh Connection">
                                        <PathIcon Data="{StaticResource arrow_counterclockwise_regular}" Foreground="#FFFFFF" />
                                    </Button>
                                    <AutoCompleteBox
                                        Grid.Column="1"
                                        Margin="0,0,4,0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        Background="#2C2C2C"
                                        BorderBrush="#3d444d"
                                        BorderThickness="1"
                                        FontSize="14"
                                        Foreground="#FFFFFF"
                                        Watermark="Search tables">
                                        <AutoCompleteBox.Styles>
                                            <Style Selector="TextBox">
                                                <Setter Property="Watermark" Value="Search tables" />
                                                <Setter Property="Foreground" Value="#9E9E9E" />
                                            </Style>
                                        </AutoCompleteBox.Styles>
                                    </AutoCompleteBox>
                                </Grid>
                                <ScrollViewer Grid.Row="1">
                                    <TreeView ItemsSource="{Binding TreeItems}">
                                        <TreeView.ItemContainerTheme>
                                            <ControlTheme BasedOn="{StaticResource {x:Type TreeViewItem}}" TargetType="TreeViewItem">
                                                <Setter Property="IsExpanded" Value="True" />
                                            </ControlTheme>
                                        </TreeView.ItemContainerTheme>
                                        <TreeView.DataTemplates>
                                            <!--  Root node: Database as "Tables"  -->
                                            <TreeDataTemplate DataType="models:Database" ItemsSource="{Binding Tables}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon
                                                        Data="{StaticResource table_regular}"
                                                        FontSize="14"
                                                        Foreground="#4CAF50" />
                                                    <TextBlock
                                                        FontSize="14"
                                                        FontWeight="Bold"
                                                        Foreground="#FFFFFF"
                                                        Text="{Binding Header}" />
                                                </StackPanel>
                                            </TreeDataTemplate>

                                            <!--  Table node  -->
                                            <TreeDataTemplate DataType="models:Table" ItemsSource="{Binding Columns}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <PathIcon
                                                        Data="{StaticResource table_regular}"
                                                        FontSize="12"
                                                        Foreground="#2196F3" />
                                                    <TextBlock
                                                        FontSize="13"
                                                        Foreground="#E3F2FD"
                                                        Text="{Binding Name}" />
                                                </StackPanel>
                                            </TreeDataTemplate>

                                            <!--  Column node  -->
                                            <DataTemplate DataType="models:Column">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="#FFFFFF"
                                                        Text="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        Foreground="#8BC34A"
                                                        Text="{Binding DataType}" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#FF9800"
                                                        IsVisible="{Binding IsPrimaryKey}"
                                                        Text="PK" />
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Foreground="#FF5722"
                                                        IsVisible="{Binding IsForeignKey}"
                                                        Text="FK" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </TreeView.DataTemplates>
                                    </TreeView>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                        <!--  EDITOR  -->
                        <Border
                            x:Name="EditorBorder"
                            Grid.Row="1"
                            Grid.Column="2"
                            BorderBrush="#3d444d"
                            BorderThickness="2"
                            ClipToBounds="True">
                            <Grid RowDefinitions="auto,*,auto">
                                <TextBlock
                                    Margin="4"
                                    FontWeight="SemiBold"
                                    Text="Query Editor" />
                                <AvaloniaEdit:TextEditor
                                    x:Name="sqlEditor"
                                    Grid.Row="1"
                                    Background="#2c2c2c"
                                    Document="{Binding CurrentSessionQuery.EditorContent, Mode=TwoWay}"
                                    FontFamily="Cascadia Code,Consolas,Menlo,Monospace"
                                    FontSize="14"
                                    HorizontalScrollBarVisibility="Auto"
                                    ShowLineNumbers="True"
                                    VerticalScrollBarVisibility="Visible" />
                                <Grid Grid.Row="2" ColumnDefinitions="*,auto">
                                    <StackPanel
                                        Grid.Column="0"
                                        Margin="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <TextBlock VerticalAlignment="Center" Text="Line:" />
                                            <TextBlock
                                                x:Name="LineNumberText"
                                                Margin="5,0"
                                                VerticalAlignment="Center" />
                                            <TextBlock VerticalAlignment="Center" Text="Column:" />
                                            <TextBlock
                                                x:Name="ColumnNumberText"
                                                Margin="5,0"
                                                VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button Command="{Binding NavigateBackwardCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <PathIcon Data="{StaticResource arrow_left_regular}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding NavigateForwardCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <PathIcon Data="{StaticResource arrow_right_regular}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <StackPanel Orientation="Horizontal" Spacing="2">
                                            <Button>
                                                <StackPanel Orientation="Horizontal">
                                                    <PathIcon Data="{StaticResource save_as_regular}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="ExecuteSqlButton"
                                                Background="{DynamicResource SystemAccentColor}"
                                                Command="{Binding ExecuteCommandCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <PathIcon Data="{StaticResource play_regular}" />
                                                    <TextBlock Text="Run" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" />

                    <!--  RESULT AND CHART VIEW  -->
                    <Border
                        Grid.Row="2"
                        Margin="2,0,0,2"
                        BorderThickness="1">
                        <Grid>
                            <TabControl>

                                <!--  RESULTS  -->
                                <TabItem Header="Results">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Orientation="Vertical" Spacing="8">
                                            <TextBlock Foreground="#9b8aff" Text="Run a Query to populate this view" />
                                            <TreeDataGrid
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                BorderBrush="#3D444D"
                                                BorderThickness="1"
                                                ShowColumnHeaders="True"
                                                Source="{Binding DataGridSource}" />
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

                <!--  AI CHAT INTERFACE  -->
                <Border
                    Grid.Column="2"
                    Margin="0,0,2,2"
                    Background="#2C2C2C"
                    BorderBrush="#3D444D"
                    BorderThickness="1"
                    CornerRadius="5">
                    <Grid Margin="8" RowDefinitions="Auto,*,Auto,Auto">
                        <!--  Reset Chat Button  -->
                        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                            <Button
                                Grid.Column="1"
                                Padding="8,4"
                                HorizontalAlignment="Right"
                                Background="#FF5722"
                                BorderBrush="#E64A19"
                                BorderThickness="1"
                                Command="{Binding ResetChatCommand}"
                                Content="Reset Chat"
                                Foreground="#FFFFFF" />
                        </Grid>

                        <!--  Chat ListBox  -->
                        <ListBox
                            Grid.Row="1"
                            AutoScrollToSelectedItem="True"
                            Background="#1E1E1E"
                            BorderBrush="#3D444D"
                            BorderThickness="1"
                            ItemsSource="{Binding Chat}"
                            SelectedItem="{Binding LastMessage, Mode=TwoWay}"
                            SelectionMode="Single">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel Orientation="Vertical" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="models:Message">
                                    <Border
                                        Margin="4"
                                        Padding="8"
                                        Background="#2C2C2C"
                                        BorderBrush="{Binding ., Converter={StaticResource ChatAuthorConverter}, ConverterParameter=BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="5">
                                        <StackPanel Background="Transparent" Spacing="4">
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                Orientation="Horizontal"
                                                Spacing="8">
                                                <TextBlock
                                                    FontSize="14"
                                                    FontWeight="Bold"
                                                    Foreground="{Binding ., Converter={StaticResource ChatAuthorConverter}, ConverterParameter=IconColor}"
                                                    Text="{Binding ., Converter={StaticResource ChatAuthorConverter}, ConverterParameter=Icon}" />
                                                <TextBlock
                                                    x:Name="SenderName"
                                                    FontSize="14"
                                                    FontWeight="SemiBold"
                                                    Foreground="{StaticResource AccentAAFillColorDefaultBrush}"
                                                    Text="{Binding ., Converter={StaticResource ChatAuthorConverter}, ConverterParameter=SenderName}" />
                                            </StackPanel>
                                            <md:MarkdownScrollViewer Margin="4,0,0,0" Markdown="{Binding Text}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--  Separator  -->
                        <Separator
                            Grid.Row="2"
                            Height="1"
                            Background="#3D444D" />

                        <ProgressBar
                            Grid.Row="2"
                            Height="2"
                            IsIndeterminate="{Binding ChatIsBusy}"
                            IsVisible="{Binding ChatIsBusy}" />

                        <!--  User Input Section  -->
                        <Grid
                            Grid.Row="3"
                            Margin="0,8,0,0"
                            RowDefinitions="Auto,*">
                            <CheckBox
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                Content="Include Editor Content"
                                Foreground="#FFFFFF" />
                            <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                                <TextBox
                                    Grid.Column="0"
                                    Background="#1E1E1E"
                                    BorderBrush="#3D444D"
                                    BorderThickness="1"
                                    FontSize="14"
                                    Foreground="#FFFFFF"
                                    Text="{Binding UserPrompt, Mode=TwoWay}"
                                    Watermark="Chat with Rebyu AI Agents...">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Command="{Binding ProcessUserPromptCommand}" Gesture="Enter" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Background="{DynamicResource SystemAccentBrush}"
                                    Command="{Binding ProcessUserPromptCommand}"
                                    Foreground="#FFFFFF">
                                    <PathIcon Data="{StaticResource send_regular}" Foreground="#FFFFFF" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!--  PLACEHOLDER VIEW  -->
        <StackPanel
            x:Name="PlaceholderPanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsVisible="{Binding !IsConnected}">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="28"
                FontWeight="SemiBold"
                Text="Welcome to Rebyu!" />

            <TextBlock
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="20"
                Text="Yet a simple SQLite Database viewer with AI Agents"
                TextWrapping="Wrap" />

            <Button
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Command="{Binding SelectDbFileCommand}"
                Content="Select Database" />


            <!--
            <Separator Margin="16" />

            <Button
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource SystemFillColorSuccessBrush}"
                Content="Saved sessions" />-->

        </StackPanel>
    </Grid>
</UserControl>
